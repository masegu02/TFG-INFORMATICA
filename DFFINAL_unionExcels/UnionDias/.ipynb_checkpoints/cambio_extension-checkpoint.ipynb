    "import pandas as pd\n",
    "\n",
    "# Leer el CSV\n",
    "df = pd.read_csv(\n",
    "    \"DF_FINAL.csv\",\n",
    "    sep=\";\",              # usa ';' porque es el que habéis estado usando\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "# Guardar a Excel\n",
    "df.to_excel(\"DF_FINAL.xlsx\", index=False)\n",
    "\n",
    "print(\"✅ DF_FINAL.xlsx generado correctamente\")"
   ]
  }
